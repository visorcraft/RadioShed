root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts,java}]
indent_size = 4
max_line_length = 120
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_packages_to_use_import_on_demand = unset
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# ktlint rule overrides. Run via ./gradlew ktlintCheck / ktlintFormat.
[*.{kt,kts}]
# Compose @Composable functions are PascalCase nouns (NowPlayingScreen,
# MiniPlayer, SettingsRow) — that is the framework's required convention,
# but ktlint's function-naming rule only allows camelCase. Disable it
# rather than rename every screen.
ktlint_standard_function-naming = disabled

[*.swift]
indent_size = 4
max_line_length = 120

[*.{xml,html}]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf

[gradlew.bat]
end_of_line = crlf
