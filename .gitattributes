# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# ---- Force LF on shell scripts / Unix tools ----
*.sh text eol=lf
gradlew text eol=lf
*.py text eol=lf

# ---- Force CRLF on Windows-only files ----
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# ---- Source files ----
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# ---- Binary files ----
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.aar binary
*.jar binary
*.war binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.class binary
*.dex binary
*.apk binary
*.aab binary
*.ipa binary
*.keystore binary
*.jks binary
*.p12 binary
*.framework binary

# ---- Audio (test fixtures) ----
*.mp3 binary
*.flac binary
*.ogg binary
*.opus binary
*.wav binary
*.m4a binary
*.aac binary
*.wma binary
*.dsf binary
