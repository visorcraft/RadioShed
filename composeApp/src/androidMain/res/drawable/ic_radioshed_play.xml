<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled play arrow used by the home-screen widget. Mirrors the
  PlayArrow icon vector data from material-icons-extended at a
  fixed 24dp viewport so RemoteViews can render it without bringing
  the icon font into the widget process.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8,5v14l11,-7z" />
</vector>
