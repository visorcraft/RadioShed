<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon. Android requires this be a flat, opaque-only,
  white-on-transparent silhouette — the system tints + masks it
  automatically against the notification background. Using anything
  with color or a non-transparent background results in a white
  square or grey blob on Android 5+ status bars.

  The shape is a stylized broadcast antenna: a vertical mast with
  three concentric arcs evoking a transmission. Picks up the
  RadioShed name without requiring brand colors that would render
  as a flat silhouette anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@android:color/white">
    <!-- Center mast / dot -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11,5h2v14h-2z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,11m-2,0a2,2 0,1,0 4,0a2,2 0,1,0 -4,0" />
    <!-- Left + right inner arcs (signal close) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.05,7.05a7,7 0,0 0,0 9.9l1.41,-1.41a5,5 0,0 1,0 -7.07Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M16.95,7.05l-1.41,1.42a5,5 0,0 1,0 7.07l1.41,1.41a7,7 0,0 0,0 -9.9Z" />
    <!-- Outer arcs (signal far) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4.22,4.22a11,11 0,0 0,0 15.56l1.42,-1.42a9,9 0,0 1,0 -12.72Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19.78,4.22l-1.42,1.42a9,9 0,0 1,0 12.72l1.42,1.42a11,11 0,0 0,0 -15.56Z" />
</vector>
