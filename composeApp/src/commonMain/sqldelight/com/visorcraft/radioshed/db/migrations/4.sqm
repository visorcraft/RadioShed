-- Migration v4 → v5: lyrics query override.
--
CREATE TABLE IF NOT EXISTS track (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT
);

-- Adds user-supplied (artist, title) override for lyrics lookups.
-- Used when LRClib's auto-fallback chain misses but the user knows
-- the correct metadata — they can edit the search query manually
-- from the Lyrics not-found state, and we persist it per track so
-- subsequent refreshes use the correction without re-asking.

CREATE TABLE lyrics_query_override (
    track_id INTEGER NOT NULL PRIMARY KEY REFERENCES track(id) ON DELETE CASCADE,
    artist TEXT NOT NULL,
    title TEXT NOT NULL,
    set_at INTEGER NOT NULL
);
