CREATE TABLE artist (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    sort_name TEXT NOT NULL UNIQUE,
    musicbrainz_id TEXT,
    image_uri TEXT,
    bio TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Note: `sort_name TEXT NOT NULL UNIQUE` already creates an implicit index;
-- no separate artist_sort_idx is required.

CREATE TABLE album (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    artist_id INTEGER REFERENCES artist(id) ON DELETE SET NULL,
    sort_title TEXT NOT NULL,
    year INTEGER,
    musicbrainz_id TEXT,
    artwork_uri TEXT,
    track_count INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    UNIQUE (sort_title, artist_id)
);

CREATE INDEX album_artist_idx ON album(artist_id);
CREATE INDEX album_sort_idx ON album(sort_title);

CREATE TABLE track (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    folder_id INTEGER NOT NULL REFERENCES folder(id) ON DELETE CASCADE,
    path TEXT NOT NULL UNIQUE,
    file_name TEXT NOT NULL,
    file_size INTEGER NOT NULL,
    file_ctime INTEGER NOT NULL,
    file_mtime INTEGER NOT NULL,
    title TEXT NOT NULL,
    album_id INTEGER REFERENCES album(id) ON DELETE SET NULL,
    track_number INTEGER,
    disc_number INTEGER,
    duration_ms INTEGER NOT NULL,
    bitrate_kbps INTEGER,
    sample_rate_hz INTEGER,
    channels INTEGER,
    format TEXT NOT NULL,
    replay_gain_track REAL,
    replay_gain_album REAL,
    replay_gain_track_peak REAL,
    bpm REAL,
    musicbrainz_id TEXT,
    acoustid_fingerprint TEXT,
    cue_offset_start_ms INTEGER,
    cue_offset_end_ms INTEGER,
    is_available INTEGER NOT NULL DEFAULT 1,
    added_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX track_folder_idx ON track(folder_id);
CREATE INDEX track_album_idx ON track(album_id);
CREATE INDEX track_added_idx ON track(added_at);
CREATE INDEX track_format_idx ON track(format);
CREATE INDEX track_available_idx ON track(is_available);

CREATE TABLE track_artist (
    track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
    artist_id INTEGER NOT NULL REFERENCES artist(id) ON DELETE CASCADE,
    role TEXT NOT NULL DEFAULT 'primary',
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (track_id, artist_id, role)
);

CREATE INDEX track_artist_a_idx ON track_artist(artist_id);

CREATE TABLE track_tag (
    track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
    key TEXT NOT NULL,
    value TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (track_id, key, position)
);

CREATE INDEX track_tag_kv_idx ON track_tag(key, value);

CREATE TABLE track_personnel (
    track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
    role TEXT NOT NULL,
    name TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (track_id, role, position)
);

-- ==== Artist queries ====

-- Race-safe insert: ignores conflict on `sort_name UNIQUE` so concurrent
-- scanner coroutines can both call this and the second silently no-ops.
-- Pair with selectArtistIdBySortName to retrieve the resulting id.
insertArtistOrIgnore:
INSERT OR IGNORE INTO artist (name, sort_name, musicbrainz_id, image_uri, bio, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectArtistIdBySortName:
SELECT id FROM artist WHERE sort_name = ?;

selectArtistById:
SELECT * FROM artist WHERE id = ?;

selectArtistBySortName:
SELECT * FROM artist WHERE sort_name = ?;

selectAllArtists:
SELECT * FROM artist ORDER BY sort_name;

countArtists:
SELECT COUNT(*) FROM artist;

updateArtistImage:
UPDATE artist SET image_uri = ?, updated_at = ? WHERE id = ?;

updateArtistBio:
UPDATE artist SET bio = ?, updated_at = ? WHERE id = ?;

deleteArtistById:
DELETE FROM artist WHERE id = ?;

-- ==== Album queries ====

-- Race-safe insert: ignores conflict on `(sort_title, artist_id)` UNIQUE so
-- concurrent scanner coroutines can both call this. Pair with
-- selectAlbumIdByTitleAndArtist to retrieve the resulting id.
insertAlbumOrIgnore:
INSERT OR IGNORE INTO album (title, artist_id, sort_title, year, musicbrainz_id, artwork_uri, track_count, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAlbumIdByTitleAndArtist:
SELECT id FROM album WHERE sort_title = ? AND artist_id IS ?;

selectAlbumById:
SELECT * FROM album WHERE id = ?;

selectAlbumByTitleAndArtist:
SELECT * FROM album WHERE sort_title = ? AND artist_id IS ?;

selectAlbumsByArtist:
SELECT * FROM album WHERE artist_id = ? ORDER BY year, sort_title;

selectAllAlbums:
SELECT * FROM album ORDER BY sort_title;

countAlbums:
SELECT COUNT(*) FROM album;

updateAlbumArtwork:
UPDATE album SET artwork_uri = ?, updated_at = ? WHERE id = ?;

updateAlbumTrackCount:
UPDATE album SET track_count = ?, updated_at = ? WHERE id = ?;

deleteAlbumById:
DELETE FROM album WHERE id = ?;

-- ==== Track queries ====

-- Real upsert: race-safe AND rescan-aware. On first insert, every column is
-- written. On rescan (path UNIQUE conflict), every metadata column is
-- refreshed from `excluded.*` so re-tagged files reflect their new state.
-- We deliberately preserve `added_at` (when first scanned) — only `updated_at`
-- moves forward. Re-availability is implicit: a track that gets re-scanned
-- is by definition available, so is_available resets to 1.
upsertTrack:
INSERT INTO track (
    folder_id, path, file_name, file_size, file_ctime, file_mtime,
    title, album_id, track_number, disc_number, duration_ms,
    bitrate_kbps, sample_rate_hz, channels, format,
    replay_gain_track, replay_gain_album, replay_gain_track_peak,
    bpm, musicbrainz_id, acoustid_fingerprint,
    cue_offset_start_ms, cue_offset_end_ms,
    added_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(path) DO UPDATE SET
    folder_id = excluded.folder_id,
    file_name = excluded.file_name,
    file_size = excluded.file_size,
    file_ctime = excluded.file_ctime,
    file_mtime = excluded.file_mtime,
    title = excluded.title,
    album_id = excluded.album_id,
    track_number = excluded.track_number,
    disc_number = excluded.disc_number,
    duration_ms = excluded.duration_ms,
    bitrate_kbps = excluded.bitrate_kbps,
    sample_rate_hz = excluded.sample_rate_hz,
    channels = excluded.channels,
    format = excluded.format,
    replay_gain_track = excluded.replay_gain_track,
    replay_gain_album = excluded.replay_gain_album,
    replay_gain_track_peak = excluded.replay_gain_track_peak,
    bpm = excluded.bpm,
    musicbrainz_id = excluded.musicbrainz_id,
    acoustid_fingerprint = excluded.acoustid_fingerprint,
    cue_offset_start_ms = excluded.cue_offset_start_ms,
    cue_offset_end_ms = excluded.cue_offset_end_ms,
    is_available = 1,
    updated_at = excluded.updated_at;

selectTrackIdByPath:
SELECT id FROM track WHERE path = ?;

selectTrackById:
SELECT * FROM track WHERE id = ?;

selectTrackByPath:
SELECT * FROM track WHERE path = ?;

selectTracksByFolder:
SELECT * FROM track WHERE folder_id = ? ORDER BY path;

selectTracksByAlbum:
SELECT * FROM track WHERE album_id = ? ORDER BY disc_number, track_number;

selectAvailableTracks:
SELECT * FROM track WHERE is_available = 1 ORDER BY title LIMIT ? OFFSET ?;

selectNewestTracks:
SELECT * FROM track WHERE is_available = 1 ORDER BY file_ctime DESC LIMIT ?;

selectTracksByFormat:
SELECT * FROM track WHERE format = ? AND is_available = 1 ORDER BY title;

-- LIKE-based search. Caller must already have escaped % and _ and
-- wrapped the user's query as `%escaped%`. Slow for huge libraries
-- (full table scan); FTS5 was attempted but SQLDelight 2.1's parser
-- chokes on FTS5 MATCH and on virtual tables with multi-statement
-- compound blocks. Revisit when SQLDelight 3.x or a successor handles
-- FTS5 cleanly.
searchTracksByTitleLike:
SELECT * FROM track
WHERE is_available = 1 AND title LIKE ? ESCAPE '\'
ORDER BY title COLLATE NOCASE
LIMIT ?;

searchArtistsByNameLike:
SELECT * FROM artist
WHERE name LIKE ? ESCAPE '\'
ORDER BY sort_name
LIMIT ?;

searchAlbumsByTitleLike:
SELECT * FROM album
WHERE title LIKE ? ESCAPE '\'
ORDER BY sort_title
LIMIT ?;

countTracks:
SELECT COUNT(*) FROM track;

countTracksInFolder:
SELECT COUNT(*) FROM track WHERE folder_id = ?;

setTrackAvailable:
UPDATE track SET is_available = ?, updated_at = ? WHERE id = ?;

setTracksAvailableByFolder:
UPDATE track SET is_available = ?, updated_at = ? WHERE folder_id = ?;

updateTrackReplayGain:
UPDATE track SET replay_gain_track = ?, replay_gain_album = ?, replay_gain_track_peak = ?, updated_at = ? WHERE id = ?;

deleteTrackById:
DELETE FROM track WHERE id = ?;

deleteTracksByFolder:
DELETE FROM track WHERE folder_id = ?;

-- ==== Track-artist junction ====

linkTrackArtist:
INSERT OR IGNORE INTO track_artist (track_id, artist_id, role, position) VALUES (?, ?, ?, ?);

selectArtistsByTrack:
SELECT artist.* FROM artist
JOIN track_artist ta ON ta.artist_id = artist.id
WHERE ta.track_id = ?
ORDER BY ta.role, ta.position;

selectTracksByArtist:
SELECT track.* FROM track
JOIN track_artist ta ON ta.track_id = track.id
WHERE ta.artist_id = ? AND track.is_available = 1
ORDER BY track.title;

unlinkAllArtistsFromTrack:
DELETE FROM track_artist WHERE track_id = ?;

-- ==== Track tags ====

insertTrackTag:
INSERT INTO track_tag (track_id, key, value, position) VALUES (?, ?, ?, ?);

selectTagsByTrack:
SELECT * FROM track_tag WHERE track_id = ? ORDER BY key, position;

selectTracksByTag:
SELECT track.* FROM track
JOIN track_tag tt ON tt.track_id = track.id
WHERE tt.key = ? AND tt.value = ? AND track.is_available = 1;

distinctTagValues:
SELECT DISTINCT value FROM track_tag WHERE key = ? ORDER BY value;

deleteAllTagsForTrack:
DELETE FROM track_tag WHERE track_id = ?;

-- ==== Track personnel ====

insertTrackPersonnel:
INSERT INTO track_personnel (track_id, role, name, position) VALUES (?, ?, ?, ?);

selectPersonnelByTrack:
SELECT * FROM track_personnel WHERE track_id = ? ORDER BY role, position;

deleteAllPersonnelForTrack:
DELETE FROM track_personnel WHERE track_id = ?;
