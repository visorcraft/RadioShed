CREATE TABLE station (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    color INTEGER NOT NULL DEFAULT 0,
    icon TEXT,
    artwork_uri TEXT,
    sort_position INTEGER NOT NULL DEFAULT 0,
    custom_subtitle TEXT,
    source_json TEXT NOT NULL,
    playback_json TEXT NOT NULL,
    play_count INTEGER NOT NULL DEFAULT 0,
    last_played_at INTEGER,
    total_listen_ms INTEGER NOT NULL DEFAULT 0,
    skip_rate REAL NOT NULL DEFAULT 0.0,
    is_pinned INTEGER NOT NULL DEFAULT 0,
    is_built_in INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX station_sort_idx ON station(sort_position);
CREATE INDEX station_last_played_idx ON station(last_played_at);

CREATE TABLE station_history (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    station_id INTEGER NOT NULL REFERENCES station(id) ON DELETE CASCADE,
    track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
    played_at INTEGER NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    listened_ms INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX station_history_station_idx ON station_history(station_id, played_at);
CREATE INDEX station_history_track_idx ON station_history(track_id);

-- Per-station "always include" pins. Tracks listed here are unioned
-- with the station's source-rule result during playback queue
-- evaluation, regardless of whether they'd otherwise match. Use case:
-- "the Forgotten Gems preset normally only surfaces ≥4★ tracks, but I
-- want this one specific 3★ I keep forgetting to also reliably show
-- up." Per-station so the same track can be pinned to multiple
-- stations independently.
CREATE TABLE station_pinned_track (
    station_id INTEGER NOT NULL REFERENCES station(id) ON DELETE CASCADE,
    track_id INTEGER NOT NULL REFERENCES track(id) ON DELETE CASCADE,
    pinned_at INTEGER NOT NULL,
    PRIMARY KEY (station_id, track_id)
);

CREATE INDEX station_pinned_station_idx ON station_pinned_track(station_id);

-- ==== Station queries ====

insertStation:
INSERT INTO station (name, color, icon, artwork_uri, sort_position, custom_subtitle, source_json, playback_json, is_built_in, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
RETURNING id;

selectStationById:
SELECT * FROM station WHERE id = ?;

selectAllStations:
SELECT * FROM station ORDER BY sort_position, name;

selectPinnedStations:
SELECT * FROM station WHERE is_pinned = 1 ORDER BY sort_position;

selectRecentlyPlayedStations:
SELECT * FROM station WHERE last_played_at IS NOT NULL ORDER BY last_played_at DESC LIMIT ?;

countStations:
SELECT COUNT(*) FROM station;

updateStation:
UPDATE station SET name = ?, color = ?, icon = ?, artwork_uri = ?, custom_subtitle = ?,
    source_json = ?, playback_json = ?, updated_at = ? WHERE id = ?;

updateStationStats:
UPDATE station SET play_count = ?, last_played_at = ?, total_listen_ms = ?, skip_rate = ?, updated_at = ? WHERE id = ?;

-- Atomic +1 increment on play_count + last_played_at refresh. Race-
-- safe across concurrent station starts (two read-modify-write callers
-- would clobber each other; this single statement can't).
bumpStationPlayCount:
UPDATE station SET
    play_count = play_count + 1,
    last_played_at = ?,
    updated_at = ?
WHERE id = ?;

-- Atomic accumulation of listened time (called per-track-end).
bumpStationListenedMs:
UPDATE station SET
    total_listen_ms = total_listen_ms + ?,
    updated_at = ?
WHERE id = ?;

-- Wipe denormalized per-station counters. Paired with clearAllHistory
-- so the Stats screen's Top Stations section actually resets when
-- the user clears history (Top Stations reads station.play_count, not
-- station_history aggregates).
resetAllStationStats:
UPDATE station SET
    play_count = 0,
    last_played_at = NULL,
    total_listen_ms = 0,
    skip_rate = 0.0,
    updated_at = ?;

-- Batch (track_id → play_count) for the candidate set of a station.
-- Used by PlaybackQueue's FavorUnderPlayed / FavorHigherRated
-- weighting so it can bias the random pick without a per-pick lookup.
selectPlayCountForTracks:
SELECT track_id, COUNT(*) AS plays
FROM station_history
WHERE track_id IN ?
GROUP BY track_id;

-- Per-station completion stats. Returns (station_id, plays, skips)
-- so the Home tile can render "X plays · Y% skip" without per-row
-- queries. plays = total history rows; skips = rows with
-- completed = 0 (listened < 80% of duration). Stations with no
-- history are absent from the result and treated as zero by callers.
selectStationCompletionRates:
SELECT station_id,
       COUNT(*) AS plays,
       SUM(CASE WHEN completed = 0 THEN 1 ELSE 0 END) AS skips
FROM station_history
GROUP BY station_id;

-- Track-level play/skip stats for the Track Info dialog. Unlike the
-- batched version above, this is a single-track aggregate including
-- skip count (incomplete plays) and total listened time so the
-- Track Info dialog can show real listening numbers, not just the
-- total play count.
selectTrackHistoryStats:
SELECT
    COUNT(*) AS plays,
    SUM(CASE WHEN completed = 1 THEN 1 ELSE 0 END) AS completes,
    SUM(CASE WHEN completed = 0 THEN 1 ELSE 0 END) AS skips,
    IFNULL(SUM(listened_ms), 0) AS listened_ms
FROM station_history
WHERE track_id = ?;

reorderStation:
UPDATE station SET sort_position = ?, updated_at = ? WHERE id = ?;

setStationPinned:
UPDATE station SET is_pinned = ?, updated_at = ? WHERE id = ?;

deleteStationById:
DELETE FROM station WHERE id = ?;

-- ==== Station history queries ====

recordPlay:
INSERT INTO station_history (station_id, track_id, played_at, completed, listened_ms)
VALUES (?, ?, ?, ?, ?)
RETURNING id;

selectHistoryByStation:
SELECT * FROM station_history WHERE station_id = ? ORDER BY played_at DESC LIMIT ?;

-- Global play history across all stations, newest first. Joins station
-- name in so the UI doesn't have to do a per-row station lookup.
selectAllHistory:
SELECT sh.id AS history_id, sh.track_id, sh.station_id, sh.played_at,
       sh.completed, sh.listened_ms, station.name AS station_name
FROM station_history sh
JOIN station ON station.id = sh.station_id
ORDER BY sh.played_at DESC
LIMIT ?;

selectRecentTrackIdsForStation:
SELECT track_id FROM station_history WHERE station_id = ? ORDER BY played_at DESC LIMIT ?;

countHistoryForStation:
SELECT COUNT(*) FROM station_history WHERE station_id = ?;

deleteHistoryByStation:
DELETE FROM station_history WHERE station_id = ?;

trimHistoryOlderThan:
DELETE FROM station_history WHERE played_at < ?;

clearAllHistory:
DELETE FROM station_history;

-- Aggregated listening stats. Used by the Listening Stats screen.
-- Top tracks across all stations (most plays first); ties broken by
-- most-recent play so the user always sees something fresh.
selectTopPlayedTrackIds:
SELECT track_id, COUNT(*) AS play_count, MAX(played_at) AS last_played_at
FROM station_history
GROUP BY track_id
ORDER BY play_count DESC, last_played_at DESC
LIMIT ?;

-- Total cumulative listened time across all stations / tracks. Used
-- as a header stat on the Listening Stats screen. IFNULL handles the
-- cold-start case where there are no rows yet.
totalListenedMs:
SELECT IFNULL(SUM(listened_ms), 0) FROM station_history;

countAllPlays:
SELECT COUNT(*) FROM station_history;

-- Top artists by play count, joining through track_artist (primary
-- role only — features / album-artist links would over-count). Returns
-- (artistId, artistName, plays). Album/album-artist counted as plays
-- of the primary artist of each track regardless.
selectTopPlayedArtists:
SELECT artist.id AS artist_id, artist.name AS artist_name, COUNT(*) AS plays
FROM station_history sh
JOIN track t ON t.id = sh.track_id
JOIN track_artist ta ON ta.track_id = t.id
JOIN artist ON artist.id = ta.artist_id
WHERE ta.role = 'primary'
GROUP BY artist.id
ORDER BY plays DESC, MAX(sh.played_at) DESC
LIMIT ?;

-- "Rediscover" feed — track ids that the user has played at least
-- once but whose most-recent play is older than the threshold passed
-- in. Sorted oldest-first so we surface the longest-forgotten tracks.
-- The HAVING clause filters on the aggregate so the index on
-- played_at can still drive the scan.
selectRediscoverTrackIds:
SELECT track_id, MAX(played_at) AS last_played_at, COUNT(*) AS plays
FROM station_history
GROUP BY track_id
HAVING last_played_at < ? AND plays >= 1
ORDER BY last_played_at ASC
LIMIT ?;

-- ==== Station pinned-track queries ====

pinTrackToStation:
INSERT OR REPLACE INTO station_pinned_track (station_id, track_id, pinned_at)
VALUES (?, ?, ?);

unpinTrackFromStation:
DELETE FROM station_pinned_track WHERE station_id = ? AND track_id = ?;

isTrackPinnedToStation:
SELECT COUNT(*) FROM station_pinned_track
WHERE station_id = ? AND track_id = ?;

selectPinnedTracksForStation:
SELECT track.* FROM track
JOIN station_pinned_track p ON p.track_id = track.id
WHERE p.station_id = ? AND track.is_available = 1
ORDER BY p.pinned_at DESC;

selectPinnedTrackIdsForStation:
SELECT track_id FROM station_pinned_track WHERE station_id = ?;

countPinnedTracksForStation:
SELECT COUNT(*) FROM station_pinned_track WHERE station_id = ?;

-- Top albums by play count. Tracks without album_id are excluded from
-- the count. Album artwork URI included so the UI doesn't need a
-- second per-row query.
selectTopPlayedAlbums:
SELECT album.id AS album_id, album.title AS album_title,
       album.artwork_uri AS artwork_uri, COUNT(*) AS plays
FROM station_history sh
JOIN track t ON t.id = sh.track_id
JOIN album ON album.id = t.album_id
WHERE t.album_id IS NOT NULL
GROUP BY album.id
ORDER BY plays DESC, MAX(sh.played_at) DESC
LIMIT ?;
